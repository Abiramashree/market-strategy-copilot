# Copy to .env and adjust. Defaults target a local open-source (Ollama) setup.

# --- LLM backend: "ollama" | "openai" | "gemini" ---
LLM_PROVIDER=ollama

# ollama (local open-source models)
OLLAMA_BASE_URL=http://localhost:11434
SUMMARY_MODEL=llama3.1:8b
AGENT_MODEL=llama3.1:8b

# openai (any OpenAI-compatible endpoint: OpenRouter / Groq / LiteLLM / vLLM)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# AGENT_MODEL=google/gemma-4-26b-a4b-it:free

# gemini (native Google Gemini)
# GOOGLE_API_KEY=AIza...
# AGENT_MODEL=gemini-3.5-flash-lite
# SUMMARY_MODEL=gemini-3.5-flash-lite

# --- Retrieval ---
EMBED_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6

# --- Data / index ---
DATA_DIR=data/casestudies
PERSIST_DIR=faiss_store
